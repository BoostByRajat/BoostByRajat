# Free AI — never commit real keys
# Groq: https://console.groq.com/keys

GROQ_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=groq
VENDOR_LANG=hi
VENDOR_DESK_PASSWORD=change-me
WHATSAPP_NUMBER=
VITE_WHATSAPP_NUMBER=
PUBLIC_EMAIL=
# Live site. boostbyrajat.co.in redirects here. Invoice links use this in production.
PUBLIC_SITE_URL=https://www.boostbyrajat.co.in

# Invoice desk — optional. Without SMTP, Email opens your mail app and downloads the PDF.
# Gmail: turn on 2-Step Verification, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
INVOICE_UPI=

# Official WhatsApp Cloud API (BBR Send panel). Leave blank until Meta approves the number.
# No QR and no linked device. Utility template body, in order:
# {{1}} client name  {{2}} invoice number  {{3}} total  {{4}} advance  {{5}} pending  {{6}} invoice link
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Set to 1 only when that approved template has a PDF document header.
WHATSAPP_TEMPLATE_DOCUMENT=

# Google (client-side — also set on Render)
# Analytics: https://analytics.google.com → Admin → Data streams → Measurement ID (G-XXXX)
VITE_GA_MEASUREMENT_ID=
# Search Console: HTML tag method → content="...." value only
VITE_GSC_VERIFICATION=
