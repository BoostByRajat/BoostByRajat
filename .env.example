# Free AI — never commit real keys
# Groq: https://console.groq.com/keys

GROQ_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=groq
VENDOR_LANG=hi
# Invoice and Translate login: username rajat, this password.
VENDOR_DESK_PASSWORD=change-me
# Optional. Signs the login cookie. Defaults to VENDOR_DESK_PASSWORD.
SESSION_SECRET=
WHATSAPP_NUMBER=
VITE_WHATSAPP_NUMBER=
PUBLIC_EMAIL=
# Live site. boostbyrajat.co.in redirects here. Invoice links use this in production.
PUBLIC_SITE_URL=https://www.boostbyrajat.co.in

# Bills, quotations, clients, and leads. Survives deploys when this folder is a persistent disk.
# Render mount: /var/data. Locally leave blank to use ./data
DATA_DIR=
# Private GitHub repo that keeps those JSON files across deploys. Token needs repo access.
GITHUB_DATA_REPO=BoostByRajat/bbr-desk-data
GITHUB_DATA_TOKEN=
# Invoice desk — optional. Without SMTP, Email opens your mail app and downloads the PDF.
# Gmail: turn on 2-Step Verification, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Live site sends through a private Gmail web app because Render free blocks SMTP ports.
GMAIL_RELAY_URL=
GMAIL_RELAY_SECRET=
INVOICE_UPI=

# Official WhatsApp Cloud API (BBR Send panel). Leave blank until Meta approves the number.
# No QR and no linked device. Utility template body, in order:
# {{1}} client name  {{2}} invoice number  {{3}} total  {{4}} advance  {{5}} pending  {{6}} invoice link
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Set to 1 only when that approved template has a PDF document header.
WHATSAPP_TEMPLATE_DOCUMENT=
# Quotation template, same 6 body variables. Until this is set, the quote still saves and the message is copied.
WHATSAPP_QUOTE_TEMPLATE=
WHATSAPP_QUOTE_TEMPLATE_DOCUMENT=

# Google (client-side — also set on Render)
# Analytics: https://analytics.google.com → Admin → Data streams → Measurement ID (G-XXXX)
VITE_GA_MEASUREMENT_ID=G-H65FJQ44E0
# Search Console: HTML tag method → content="...." value only
VITE_GSC_VERIFICATION=QFW5XG3zc0n2irgNVCW5eMlRx6plJE1agwFd8XPGeU0
